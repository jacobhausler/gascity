sh -c 'case "$GC_SESSION_ORIGIN" in ephemeral|"") ;; *) exit 0 ;; esac; probe_pool_demand() { target="$1"; [ -z "$target" ] && return 1; r=$(gc_routed_live=$(gc ready --include-ephemeral --metadata-field "gc.routed_to=$target" --metadata-field "gc.root_bead_id" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --limit=20) || exit $?; gc_routed_aged=$({ ready_json=$(gc ready --include-ephemeral --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --limit 0); ready_status=$?; [ "$ready_status" -eq 0 ] || exit "$ready_status"; printf "%s" "$ready_json" | jq '\''[.[] | select((.metadata["gc.kind"] // "") != "workflow")] | .[:20]'\''; }) || exit $?; gc_routed_merged=$(printf '%s\n%s' "$gc_routed_live" "$gc_routed_aged" | jq -c -s 'reduce .[] as $rows ([]; . + $rows) | unique_by(.id) | sort_by([((.priority // 9) | tostring), ((.created_at // "") | tostring), (.id // "")]) | .[:20]' 2>/dev/null); [ -n "$gc_routed_merged" ] || gc_routed_merged="$gc_routed_live"; [ "$gc_routed_merged" != "null" ] || gc_routed_merged="$gc_routed_live"; printf "%s" "$gc_routed_merged") || exit $?; gc_preferred_pool_demand=$(printf "%s" "$r" | jq -c '\''[.[] | select((((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.formula_contract"] // "") == "graph.v2")) | not)] + [.[] | select(((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.formula_contract"] // "") == "graph.v2"))]'\'' 2>/dev/null); [ -n "$gc_preferred_pool_demand" ] && r="$gc_preferred_pool_demand"; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_candidates=$(gc ready --include-ephemeral --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --sort oldest --limit=20) || exit $?; r=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select((.metadata["gc.routed_to"] // "") == "")] | .[:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_ephemeral_candidates=$(printf "[]"); r=$(printf "%s" "$legacy_ephemeral_candidates" | jq '\''.[0:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; return 1; }; probe_pool_demand "$1"; printf "[]"' -- worker